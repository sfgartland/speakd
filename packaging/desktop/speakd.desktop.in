[Desktop Entry]
Type=Application
Name=speakd
GenericName=Speech monitor
Comment=Hear and follow what your AI agents say
Exec=@ROOT@/packaging/desktop/speakd-gui
Icon=@ROOT@/clients/gui/app/src-tauri/icons/128x128@2x.png
Terminal=false
Categories=AudioVideo;Audio;
Keywords=tts;speech;voice;agent;claude;
StartupNotify=false
StartupWMClass=@WMCLASS@
