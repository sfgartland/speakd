{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "speakd",
  "version": "0.1.0",
  "identifier": "com.speakd.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "pinned.html",
        "title": "speakd",
        "width": 384,
        "height": 560,
        "minWidth": 320,
        "maxWidth": 800,
        "minHeight": 300,
        "maxHeight": 2000,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
